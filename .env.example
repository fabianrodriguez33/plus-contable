# Copie este archivo a ".env" (ignorado por git) y complete los valores. NUNCA suba el .env.
# Los servicios lo leen solos si arrancan desde backend/ms-auth o backend/ms-tributario;
# las variables del sistema operativo tienen prioridad sobre este archivo.
# Formato .properties: un KEY=valor por linea, sin comillas y sin comentarios al final de la linea.

# --- PostgreSQL (docker-compose.yml; solo se aplica al crear el volumen) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=plus_contable_db

# --- Conexion de ms-auth y ms-tributario ---
DB_URL=jdbc:postgresql://localhost:5432/plus_contable_db
DB_USER=postgres
DB_PASSWORD=

# --- Usuarios de base de datos por servicio (opcional, HT-01) ---
# Cada servicio se conecta con su propio usuario, que solo puede usar su esquema. Si no se definen, ambos usan DB_USER y DB_PASSWORD.
# Las contrasenas las inventa cada persona: no se versionan. Detalle en el README ("Usuarios de base de datos por servicio").
# Descomente las cuatro lineas y ponga contrasenas propias. No las deje con valor vacio: un valor vacio NO activa el respaldo.
#AUTH_DB_USER=ms_auth
#AUTH_DB_PASSWORD=
#TRIBUTARIO_DB_USER=ms_tributario
#TRIBUTARIO_DB_PASSWORD=

# --- JWT: el mismo valor en ms-auth y ms-tributario, minimo 32 caracteres ---
JWT_SECRET=

# --- AES (claves SOL): clave de EXACTAMENTE 32 caracteres e IV de EXACTAMENTE 16 ---
AES_SECRET_KEY=
AES_IV=

# --- Administrador inicial de ms-auth (solo se crea si no existe) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Consulta de RUC (OpenRUC, sin API key; no es un secreto) ---
# Si no se define, ms-tributario usa estos mismos valores por defecto
OPENRUC_BASE_URL=https://openruc.com
OPENRUC_TIMEOUT_MS=3000

# --- Despliegue en la nube (Render + Neon + Cloudflare Pages): ver docs/DESPLIEGUE.md ---
# En Render se definen en el panel de cada servicio (render.yaml solo lista los nombres); no se escriben aqui con valores reales.
# DB_URL en Neon: jdbc:postgresql://<host>/<base>?sslmode=require  (usuario y clave van aparte, en DB_USER y DB_PASSWORD)
# TRIBUTARIO_URL: URL publica de ms-tributario, la usa ms-auth (en local: http://localhost:8082)
#TRIBUTARIO_URL=
# CORS_ORIGINS: origen(es) de la web, separados por coma, sin barra final (en local: http://localhost:5173)
#CORS_ORIGINS=
# Opcionales (tienen valor por defecto): PORT, JAVA_OPTS, STORAGE_DIR (carpeta de archivos de ms-tributario),
# DB_POOL_MAX (conexiones maximas, 5) y DB_MAX_LIFETIME_MS (vida de una conexion, 240000)
# La web se configura aparte: frontend-web/.env.example (VITE_AUTH_URL y VITE_TRIBUTARIO_URL, en tiempo de compilacion)
