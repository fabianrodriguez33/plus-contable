# Copie este archivo a ".env" (ignorado por git) y complete los valores. NUNCA suba el .env.
# Los servicios lo leen solos si arrancan desde backend/ms-auth o backend/ms-tributario;
# las variables del sistema operativo tienen prioridad sobre este archivo.
# Formato .properties: un KEY=valor por linea, sin comillas y sin comentarios al final de la linea.

# --- PostgreSQL (docker-compose.yml; solo se aplica al crear el volumen) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=plus_contable_db

# --- Conexion de ms-auth y ms-tributario ---
DB_URL=jdbc:postgresql://localhost:5432/plus_contable_db
DB_USER=postgres
DB_PASSWORD=

# --- JWT: el mismo valor en ms-auth y ms-tributario, minimo 32 caracteres ---
JWT_SECRET=

# --- AES (claves SOL): clave de EXACTAMENTE 32 caracteres e IV de EXACTAMENTE 16 ---
AES_SECRET_KEY=
AES_IV=

# --- Administrador inicial de ms-auth (solo se crea si no existe) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Consulta de RUC (OpenRUC, sin API key; no es un secreto) ---
# Si no se define, ms-tributario usa estos mismos valores por defecto
OPENRUC_BASE_URL=https://openruc.com
OPENRUC_TIMEOUT_MS=3000
