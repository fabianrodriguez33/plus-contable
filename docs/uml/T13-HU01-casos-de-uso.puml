@startuml
!pragma layout smetana
title T13 · HU-01 · Casos de uso: registrar y consultar clientes MYPE (código de develop)
skinparam shadowing false
left to right direction

actor "Contador / Administrador\n(CONTADOR, ADMIN)" as C

rectangle "ms-tributario · /api/tributario/clientes" {
  usecase "Registrar cliente\nPOST /clientes" as UC1
  usecase "Validar RUC\n(11 dígitos, prefijo 10/15/17/20,\ndígito verificador módulo 11)" as UC2
  usecase "Verificar que el RUC no esté repetido" as UC3
  usecase "Consultar la cartera de clientes\nGET /clientes" as UC4
  usecase "Consultar la ficha de un cliente\nGET /clientes/{id}" as UC5
  usecase "Actualizar los datos del cliente\nPUT /clientes/{id}" as UC6
  usecase "Guardar credenciales SOL cifradas\nPUT /clientes/{id}/sol" as UC7
  usecase "Consultar credenciales SOL\nGET /clientes/{id}/sol" as UC8
}

C --> UC1
C --> UC4
C --> UC5
C --> UC6
C --> UC7
C --> UC8
UC1 .> UC2 : <<include>>
UC1 .> UC3 : <<include>>
UC6 .> UC2 : <<include>>
UC1 .> UC7 : <<extend>>\n(si se envían usuario y clave SOL)

note bottom of UC4
  Solo el estudio (CONTADOR o ADMIN) usa estas rutas:
  CLIENTE_MYPE recibe 403 (matriz HU-38).
end note

footer Fuente: ClienteController, ClienteService, RucValidator, SecurityConfig (develop 6db0036)
@enduml
