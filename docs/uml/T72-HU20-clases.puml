@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
title T72 · HU-20 · Clases de la validación Habido/No Habido: consulta automática con respaldo manual (diseño previo, corregido)
skinparam shadowing false
skinparam noteBackgroundColor #FFF2CC
skinparam noteBorderColor #BF9000

class ProveedorController <<nuevo>> {
  +registrarCondicionManual(ruc, dto): ProveedorDto
  +verificar(ruc): ProveedorDto
}
class CompraClienteController <<nuevo>> {
  +registrar(clienteId, dto): CompraClienteDto
  +validarMes(clienteId, periodo): ValidacionMesDto
}
class ProveedorService <<nuevo>> {
  +verificar(ruc): ProveedorDto
  +registrarCondicionManual(ruc, dto): ProveedorDto
  -vigente(proveedor, hoy): boolean
}
class CompraClienteService <<nuevo>> {
  +registrar(clienteId, dto): CompraClienteDto
  +validarMes(clienteId, periodo): ValidacionMesDto
  -clasificar(condicion): ResultadoCredito
}
interface CondicionProveedorPort <<nuevo, puerto>> {
  +consultar(ruc): ResultadoCondicion
}
class CondicionProveedorOpenRuc <<nuevo, adaptador>> {
  +consultar(ruc): ResultadoCondicion
}
interface ConsultaRuc <<existe>> {
  +consultar(ruc): ResultadoConsulta
}
class ParametroSistemaService <<definido en HU-12>> {
  +entero(clave, porDefecto): int
}
class ClienteService <<existe>> {
  +buscar(id): Cliente
}
class RucValidator <<existe>> {
  +motivoInvalido(ruc): Optional<String>
}
class Proveedor <<nuevo>> {
  id: Long
  ruc: String
  razonSocial: String
  condicionHabido: CondicionHabido
  condicionRegistradaEn: LocalDate
  fuente: FuenteCondicion
  ultimoIntentoEn: LocalDateTime
}
class CompraCliente <<nuevo>> {
  id: Long
  clienteId: Long
  proveedorId: Long
  periodo: LocalDate
  comprobante: String
  fechaComprobante: LocalDate
  igv: BigDecimal
}
enum "Cliente.CondicionHabido" as CondicionHabido <<existe>> {
  HABIDO
  NO_HABIDO
}
enum FuenteCondicion <<nuevo>> {
  AUTOMATICA
  MANUAL
}
enum ResultadoCredito <<nuevo>> {
  APTA_CREDITO_FISCAL
  EN_RIESGO
  SIN_VERIFICAR
}
class ResultadoCondicion <<record, nuevo>> {
  disponible: boolean
  condicionHabido: CondicionHabido
  razonSocial: String
  fechaDatos: LocalDate
}
class CompraValidadaDto <<record, nuevo>> {
  compraId: Long
  rucProveedor: String
  razonSocialProveedor: String
  comprobante: String
  igv: BigDecimal
  condicionHabido: CondicionHabido
  fuente: FuenteCondicion
  resultado: ResultadoCredito
  requiereRespaldoManual: boolean
}
class ValidacionMesDto <<record, nuevo>> {
  periodo: YearMonth
  compras: List<CompraValidadaDto>
  aptas: int
  enRiesgo: int
  sinVerificar: int
  igvEnRiesgo: BigDecimal
}
interface ProveedorRepository <<nuevo>> {
  findByRuc(ruc)
}
interface CompraClienteRepository <<nuevo>> {
  findByClienteIdAndPeriodoOrderByFechaComprobanteAsc(clienteId, periodo)
}

ProveedorController --> ProveedorService
CompraClienteController --> CompraClienteService
ProveedorService --> CondicionProveedorPort
ProveedorService --> ParametroSistemaService : proveedores.vigencia_dias
ProveedorService --> ProveedorRepository
ProveedorService --> RucValidator
CondicionProveedorOpenRuc ..|> CondicionProveedorPort
CondicionProveedorOpenRuc --> ConsultaRuc
CompraClienteService --> ClienteService : buscar(clienteId)
CompraClienteService --> ProveedorService : verificar(ruc) si no está vigente
CompraClienteService --> CompraClienteRepository
CompraClienteService ..> CompraValidadaDto
ValidacionMesDto o-- CompraValidadaDto
CompraClienteController ..> ValidacionMesDto
ProveedorRepository ..> Proveedor
CompraClienteRepository ..> CompraCliente
Proveedor --> CondicionHabido
Proveedor --> FuenteCondicion
CompraValidadaDto --> ResultadoCredito
CompraCliente "0..*" --> "1" Proveedor : proveedor_id
CompraCliente "0..*" --> "1" Cliente : cliente_id

note bottom of CompraClienteService
  validarMes(): para cada compra del mes muestra la condición de su proveedor (criterio 1). HABIDO -> APTA_CREDITO_FISCAL (criterio 2).
  NO_HABIDO -> EN_RIESGO de perder el crédito fiscal (criterio 3). Antes de clasificar, verifica a los proveedores sin condición vigente.
end note
note right of CondicionProveedorPort
  Supuesto (decisión de Beto, 06/11): la condición de los proveedores se consulta de forma automática; el respaldo es manual.
  Supuesto: el adaptador usa ConsultaRuc, que hoy es OpenRUC (de terceros, estuvo caído); mientras no haya una fuente oficial confirmada se usa esa.
  Para pasar a una fuente oficial basta otro adaptador del puerto; el resto no cambia.
  Supuesto: si la consulta no está disponible, se usa la última condición guardada; si no hay ninguna, queda SIN_VERIFICAR con
  requiereRespaldoManual = true y el contador la registra a mano (fuente MANUAL).
  Supuesto (decisión de Beto, 06/11): los valores (porcentajes, UIT, vencimientos y plazos) se editan desde el sistema, sin tocar código; se guardan en parametros_sistema (definido en HU-12). La vigencia de una condición es proveedores.vigencia_dias (30 por defecto).
  Supuesto: las compras del mes las carga el contador a mano; de dónde salen las compras al sistema lo define HU-25.
  Supuesto: el IGV de cada compra se ingresa a mano; el riesgo es la suma del IGV de las compras de proveedores NO_HABIDO.
end note
footer Diseño previo, 06/11/2026 · corregido el 07/11/2026 con las respuestas de Beto del 06/11 · Base: criterios de aceptación de HU-20, el código y la base de develop. Código existente: model.Cliente.CondicionHabido, ClienteService.buscar, RucValidator, ruc.ConsultaRuc, ResultadoConsulta y OpenRucConsulta
@enduml
