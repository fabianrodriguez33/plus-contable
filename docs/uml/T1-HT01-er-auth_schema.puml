@startuml
!pragma layout smetana
title T1 · HT-01 · Modelo de datos de auth_schema (schema.sql de ms-auth en develop)
skinparam shadowing false
hide circle

entity "auth_schema.roles" as roles {
  * id : BIGSERIAL <<PK>>
  --
  * nombre : VARCHAR(50) <<UNIQUE>>
    descripcion : VARCHAR(200)
}

entity "auth_schema.usuarios" as usuarios {
  * id : BIGSERIAL <<PK>>
  --
  * username : VARCHAR(60) <<UNIQUE>>
  * password_hash : VARCHAR(100)
  * nombre_completo : VARCHAR(150)
    email : VARCHAR(150)
  * activo : BOOLEAN = true
  * intentos_fallidos : INTEGER = 0
    bloqueado_hasta : TIMESTAMP
  * creado_en : TIMESTAMP = ahora
    cliente_id : BIGINT
}

entity "auth_schema.usuario_roles" as usuario_roles {
  * usuario_id : BIGINT <<PK, FK>>
  * rol_id : BIGINT <<PK, FK>>
}

entity "auth_schema.bitacora_seguridad" as bitacora_seguridad {
  * id : BIGSERIAL <<PK>>
  --
    usuario_id : BIGINT
    username : VARCHAR(60)
  * evento : VARCHAR(40)
    detalle : VARCHAR(300)
    ip : VARCHAR(60)
  * fecha : TIMESTAMP = ahora
}

usuarios ||--o{ usuario_roles : usuario_id, ON DELETE CASCADE
roles ||--o{ usuario_roles : rol_id, ON DELETE CASCADE
usuarios .. bitacora_seguridad : usuario_id y username\n(referencia lógica, sin clave foránea)

note right of roles
  Filas sembradas por schema.sql: ADMIN, CONTADOR y CLIENTE_MYPE.
end note

note bottom of usuarios
  cliente_id solo se llena en la cuenta de un cliente MYPE (HU-38); sin clave foránea
  porque clientes vive en tributario_schema, otro servicio.
end note

note bottom of bitacora_seguridad
  Eventos que escribe AuthService: LOGIN_EXITOSO, LOGIN_FALLIDO, LOGIN_RECHAZADO,
  LOGIN_BLOQUEADO y CUENTA_BLOQUEADA. Índices por username y por fecha.
end note

footer Documentado el 05/11/2026 a partir del código de develop (commit 0406de0) · Fuente: backend/ms-auth/src/main/resources/schema.sql
@enduml
