@startuml
!pragma layout smetana
title T13 · HU-01 · Clases del cliente, sus credenciales SOL y la consulta de RUC (código de develop)
skinparam classAttributeIconSize 0
skinparam shadowing false

package "controller" {
  class ClienteController {
    +listar(): List<ClienteDto>
    +obtener(id): ClienteDto
    +crear(dto): ClienteDto
    +actualizar(id, dto): ClienteDto
    +guardarSol(id, dto): void
    +obtenerSol(id): CredencialSolDto
  }
}

package "service" {
  class ClienteService {
    +listar(): List<ClienteDto>
    +obtener(id): ClienteDto
    +crear(dto): ClienteDto
    +actualizar(id, dto): ClienteDto
    +guardarCredencialSol(clienteId, dto): void
    +obtenerCredencialSol(clienteId): CredencialSolDto
    +buscar(id): Cliente
    -guardarSolSiViene(clienteId, dto): void
    -aplicar(c, dto): void
    -validarRuc(ruc): void
  }
  class RucValidator <<utilidad>> {
    +{static} PREFIJOS: Set<String>
    +{static} motivoInvalido(ruc): String
    +{static} esValido(ruc): boolean
  }
}

class AesUtil {
  +encrypt(plainText): String
  +decrypt(cipherText): String
  +esLegado(cipherText): boolean
}

package "ruc" {
  class ConsultaRucController {
    +consultar(ruc): ConsultaRucDto
  }
  class ConsultaRucService {
    +consultar(ruc): ConsultaRucDto
  }
  interface ConsultaRuc {
    consultar(ruc): ResultadoConsulta
  }
  class OpenRucConsulta {
    +consultar(ruc): ResultadoConsulta
  }
  class DatosRuc <<record>> {
    ruc: String
    razonSocial: String
    estado: String
    condicion: String
    direccion: String
    ubigeo: String
    fuente: String
    fechaDatos: LocalDate
  }
  class ConsultaRucDto <<record>> {
    resultado: Resultado
    mensaje: String
    datos: Sugerencia
    avisos: List<String>
  }
}

package "model" {
  class Cliente {
    id: Long
    ruc: String
    razonSocial: String
    regimenTributario: Regimen
    condicionHabido: CondicionHabido
    direccion: String
    telefono: String
    email: String
    activo: boolean
    buenContribuyente: boolean
  }
  class CredencialSol {
    id: Long
    clienteId: Long
    usuarioSolCifrado: String
    claveSolCifrada: String
  }
}

package "dto" {
  class ClienteDto <<record>> {
    id: Long
    ruc: String
    razonSocial: String
    regimenTributario: Regimen
    condicionHabido: CondicionHabido
    direccion: String
    telefono: String
    email: String
    usuarioSol: String
    claveSol: String
    tieneClaveSol: Boolean
    buenContribuyente: Boolean
  }
  class CredencialSolDto <<record>> {
    usuarioSol: String
    claveSol: String
  }
}

interface ClienteRepository {
  existsByRuc(ruc)
  findByRuc(ruc)
}
interface CredencialSolRepository {
  findByClienteId(clienteId)
}

ClienteController --> ClienteService
ClienteController ..> ClienteDto
ClienteService --> ClienteRepository
ClienteService --> CredencialSolRepository
ClienteService ..> RucValidator : valida el RUC
ClienteService --> AesUtil : cifra y descifra SOL
ClienteService ..> CredencialSolDto
ClienteRepository ..> Cliente
CredencialSolRepository ..> CredencialSol
Cliente "1" <-- "0..1" CredencialSol : cliente_id (único)
ConsultaRucController --> ConsultaRucService
ConsultaRucService ..> RucValidator : valida el RUC
ConsultaRucService --> ConsultaRuc
ConsultaRuc <|.. OpenRucConsulta
OpenRucConsulta ..> DatosRuc
ConsultaRucService ..> ConsultaRucDto : datos sugeridos y avisos

note right of ClienteDto
  usuarioSol y claveSol solo viajan de entrada: la respuesta devuelve tieneClaveSol, no la clave.
  buenContribuyente es opcional: si no viene, al crear queda en false y al actualizar se conserva.
end note

note bottom of ConsultaRucService
  Solo consulta RUC que empiezan con 20 (el proveedor cubre personas jurídicas); con otro prefijo
  responde FUERA_DE_COBERTURA. Un estado distinto de ACTIVO o una condición distinta de HABIDO
  avisa, pero no bloquea el alta. La consulta solo sugiere datos: no guarda nada.
end note

footer Documentado el 05/11/2026 a partir del código de develop (commit 0406de0) · Fuente: backend/ms-tributario (controller, service, ruc, model, dto, repository, config/AesUtil)
@enduml
