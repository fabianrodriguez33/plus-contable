@startuml
!pragma layout smetana
title T79 · HU-22 · Estado actual, avisos e historial RUC (diseño previo)
skinparam shadowing false
skinparam noteBackgroundColor #FFF2CC
skinparam noteBorderColor #BF9000
hide circle

entity "tributario_schema.clientes" as clientes <<existe; cambios propuestos>> {
  * id : BIGSERIAL <<PK>>
  --
  * ruc : VARCHAR(11) <<UNIQUE>>
  * condicion_habido : HABIDO | NO_HABIDO <<existe>>
  * regimen_tributario : MYPE | RER | GENERAL <<existe; PR #48>>
    estado_sunat : ACTIVO | SUSPENDIDO | BAJA | DESCONOCIDO <<propuesto>>
    condicion_verificada_en : fecha y hora <<propuesto>>
  * activo : BOOLEAN <<existe>>
}
entity "Historial de verificaciones RUC\n(nombre y esquema por definir)" as historial <<propuesta pendiente de Beto>> {
  referencia al cliente
  --
  fecha y hora de consulta
  condición y estado anteriores
  condición y estado observados (si respuesta válida)
  resultado de verificación
  fuente de información
}
entity "tributario_schema.avisos" as avisos <<diseño T48; no implementado>> {
  * id : identificador propuesto
  --
  tipo : CAMBIO_CONDICION_RUC (propuesto)
  mensaje : cliente y nuevo dato
  canal : SISTEMA
  creado_en : fecha y hora
}
entity "tributario_schema.avisos_clientes" as ac <<diseño T48; no implementado>> {
  aviso_id : referencia propuesta
  cliente_id : referencia propuesta
}
entity "tributario_schema.parametros_sistema" as param <<diseño T48; no implementado>> {
  clave : ruc.verificacion_cada_dias
  valor : configurable; inicial 1 día
}

clientes ||--o{ historial : verificaciones propuestas
clientes ||--o{ ac : destinatarios propuestos
avisos ||--o{ ac : avisos internos propuestos
historial .. avisos : vínculo pendiente de diseño
param .. historial : frecuencia de verificación

note right of clientes
  Condición HABIDO / NO_HABIDO, estado SUNAT y régimen tributario
  son datos independientes. El régimen RER llegó con el PR #48.
  estado_sunat y condicion_verificada_en NO existen aún en clientes.
  Una transición válida hacia SUSPENDIDO requiere aviso interno diseñado.
end note
note bottom of historial
  Julio y Ricardo proponen estado actual más historial completo.
  Solo la persistencia histórica y sus datos siguen pendientes de Beto.
  Esta entidad no existe: nombre de tabla, columnas, tipos,
  índices y restricciones no quedan fijados por el diagrama.
  Un fallo del proveedor no confirma BAJA, SUSPENDIDO ni NO_HABIDO.
end note
note right of avisos
  Decisión de Beto comunicada por Julio: aviso INTERNO ante
  transición válida hacia BAJA, SUSPENDIDO o NO_HABIDO. Sin cambio ni
  respuesta válida, no se crea aviso. Correo electrónico pospuesto.
  avisos, avisos_clientes y parametros_sistema son diseño T48,
  no tablas implementadas.
end note
footer Diseño previo · Actualizado 11/11/2026 · Base: origin/develop 2f3f33b, PR #49 y decisión de Beto comunicada por Julio · Sin migración
@enduml
