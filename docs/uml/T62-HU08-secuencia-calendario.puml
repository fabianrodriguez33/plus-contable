@startuml
title T62 · HU-08 · Secuencia: consultar el calendario de vencimientos (código de develop, commit 5adfb88)
skinparam shadowing false
autonumber

actor "Contador" as U
participant "frontend-web\n(pantalla de calendario,\ntarea 63: por construir)" as FE
participant "JwtFilter /\nSecurityConfig" as SEC
participant "CalendarioController" as CC
participant "CalendarioService" as CS
participant "ObligacionService" as OS
participant "ObligacionRepository" as OR
database "tributario_schema" as DB
participant "CalendarioObligacionDto /\nVencimientoTributario" as DTO

U -> FE : elige cliente y rango (mes o semana)
FE -> SEC : GET /api/tributario/calendario\n?clienteId&desde&hasta&periodo&estado&situacion\n(Authorization: Bearer)
alt sin token o token inválido
  SEC --> FE : 401
else rol CLIENTE_MYPE (solo estudio: ADMIN o CONTADOR)
  SEC --> FE : 403
end
SEC -> CC : listar(clienteId, desde, hasta, periodo, estado, situacion)
CC -> CS : listar(...)
CS -> CS : validar: clienteId > 0, desde <= hasta,\nperiodo = día 1 del mes,\nsi situacion = PROXIMO entonces hasta >= hoy
alt validación fallida
  CS --> FE : 400 {"mensaje": ...}
end
CS -> OS : listar(clienteId)
OS -> OR : findByClienteIdOrderByPeriodoDesc(clienteId)
OR -> DB : SELECT obligaciones del cliente
DB --> OR : filas
OR --> OS : obligaciones
OS --> CS : List<ObligacionDto>\n(no comprueba que el cliente exista)
CS -> CS : filtrar en memoria: con fecha de vencimiento,\ndentro de desde-hasta, periodo, estado, situacion\n(PROXIMO: vence hoy o después; VENCIDO: antes de hoy)
loop por cada obligación que queda
  CS -> DTO : from(obligacion, clock)
  DTO --> CS : {obligacion, diasRestantes, vencimientoPasado}
end
CS -> CS : ordenar por fecha de vencimiento y luego por id
CS --> CC : List<CalendarioObligacionDto>
CC --> FE : 200 lista (vacía si no hay coincidencias\no si el cliente no existe)
FE -> U : agrupa por día y muestra cliente, tributo y días restantes

note over FE, DTO
  Una consulta cubre un solo cliente (clienteId obligatorio).
  Para el calendario de todos los clientes, el frontend consulta
  uno por uno (opción A elegida).
  vencimientoPasado también es verdadero para obligaciones ya declaradas.
end note
@enduml
