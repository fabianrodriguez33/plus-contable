# Variables de COMPILACION del frontend (Vite las incorpora al construir; no son secretos, cualquiera puede verlas en el navegador).
# En Cloudflare Pages se definen en el panel del proyecto. Para compilar en local: copie este archivo a ".env.production".
# URL base de cada API, sin barra final y con https.
VITE_AUTH_URL=
VITE_TRIBUTARIO_URL=
